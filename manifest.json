{
  "manifest_version": 3,
  "name": "Touch Grass",
  "version": "0.1.0",
  "description": "Extension de départ pour le workshop Touch Grass.",
  "action": {
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"]
    }
  ]
}
